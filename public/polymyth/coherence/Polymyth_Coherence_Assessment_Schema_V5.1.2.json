      "schemaRemainder": { "type": "array", "items": { "type": "string" } },
      "auditDepth": { "type": ["string", "null"], "enum": [null, "Screening", "Standard", "Deep"] },
      "intendedClaim": { "type": ["string", "null"] },
      "primaryArtifact": { "type": ["string", "null"] },
      "primaryLocators": { "type": "array", "items": { "type": "string" } },
      "auditor": { "type": ["string", "null"] },
      "independentReviewer": { "type": ["string", "null"] },
      "proposedEntries": { "type": "array", "items": { "type": "object" } },
      "humanRulings": { "type": "array", "items": { "type": "object" } },
      "reviewerRulings": { "type": "array", "items": { "type": "object" } },
      "layerResults": {
        "type": "object",
        "additionalProperties": false,
        "required": ["internal", "mezo", "external"],
        "properties": {
          "internal": { "type": ["string", "null"] },
          "mezo": { "type": ["string", "null"] },
          "external": { "type": ["string", "null"] }
        }
      },
      "blockerCodes": { "type": "array", "items": { "type": "string" } },
        "qualifiedConclusion": { "type": ["string", "null"] }
      }
    }
