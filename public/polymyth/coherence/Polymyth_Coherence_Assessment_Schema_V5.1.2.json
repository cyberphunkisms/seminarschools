      "properties": {
      "caseId": { "type": ["string", "null"], "description": "A unique non-template Case ID." },
      "workTitle": { "type": ["string", "null"] },
      "exactVersion": { "type": ["string", "null"] },
      "medium": { "type": ["string", "null"] },
      "declaredCorpus": { "type": ["string", "null"] },
      "exclusions": { "type": "array", "items": { "type": "string" } },
      "scopeId": { "type": ["string", "null"] },
      "organizingModel": { "type": ["string", "null"] },
      "protocolFit": { "type": ["string", "null"], "enum": [null, "Applicable", "Applicable with Adaptation", "Outside Protocol Scope"] },
