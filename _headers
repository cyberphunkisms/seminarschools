# HTML and unclassified routes revalidate; stable assets use bounded caching.
# Security headers — all paths
/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.google.com https://www.gstatic.com https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'self'

# Shared assets already carry release query strings on primary routes. A short
# lifetime removes repeat-request churn while keeping unversioned references
# fresh on the next day.
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/vendor/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Route-scoped code lives beside the project it powers. Keep the same bounded
# policy as shared code so repeated visits do not revalidate unchanged files.
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/teacherresources/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/teacherresources/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/saul/assets/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/saul/assets/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/leizu/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/leizu/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/bookwormcard/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/bookwormcard/glossary/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/polymyth/methodologylist/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/polymyth/archive/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/polymythseminars/events.json
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/polymythseminars/browse.json
  Cache-Control: public, max-age=300, must-revalidate

/polymythseminars/watchlist.json
  Cache-Control: public, max-age=300, must-revalidate

/polymythseminars/research.json
  Cache-Control: public, max-age=300, must-revalidate

/polymythseminars/featured.json
  Cache-Control: public, max-age=3600, must-revalidate

/polymythseminars/feeds/*
  Cache-Control: public, max-age=900, must-revalidate

# Calendar clients import and subscribe through these RFC 5545 resources.
# Explicit media types keep Google Calendar, Apple Calendar, and Outlook from
# depending on extension sniffing, including on the legacy per-event URLs.
/polymythseminars/ics/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=900, must-revalidate

/polymythseminars/feeds/*.ics
  Content-Type: text/calendar; charset=utf-8

# The concordance fetch is a multi-megabyte generated index. Keep repeat
# navigation local while allowing a fresh build to replace it within one day.
/polymyth/concordance/concordance-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/polymyth/concordance/vocabulary.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Polymyth Commons publishes versioned JSON and CSV releases. Reuse the
# compact browser indexes and complete downloads locally for one day while a
# fresh release remains discoverable through bounded stale revalidation.
/polymythlib/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Public framework mirrors are release-built and several are multi-megabyte.
# Keep repeat copy/download actions local for one day.
/polymyth/*.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Small public feeds may change between releases, so keep their reuse windows
# shorter while avoiding unconditional revalidation on every page view.
/florilegium/posts.json
  Cache-Control: public, max-age=3600, must-revalidate

/polymythseminars/candidates.json
  Cache-Control: public, max-age=300, must-revalidate

/saul/assets/*.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Block indexing on admin/internal paths (belt-and-suspenders with HTML noindex)
/polymyth/dmboard/*
  X-Robots-Tag: noindex, nofollow

/polymyth/trace/*
  X-Robots-Tag: noindex, nofollow

/polymyth/notebook/*
  X-Robots-Tag: noindex, nofollow

/data/*
  X-Robots-Tag: noindex, nofollow

/aa/cloud/*
  X-Robots-Tag: noindex, nofollow

/leizu/cloud/*
  X-Robots-Tag: noindex, nofollow

/bookwormcard/print/*
  X-Robots-Tag: noindex, nofollow

/bookwormcard/pdf/*
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

# Feed XML content-type hardening
/polymythseminars/feed.xml
  X-Content-Type-Options: nosniff
