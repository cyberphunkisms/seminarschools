        "youth recreation/workshop"
      ],
      "description": "Operation-type classification per the polymyth-broadened seminar test. Original four-condition types: lecture, screening, reading, artist-talk, panel, podcast-live, scholar-talk, philosophy-cafe, gathering. Polymyth-extension types: festival-of-form (cultural festivals enacting non-institutional forms of life), cultural-reproduction (diasporic and community festivals reproducing form-of-life outside dominant order), site-specific-art (festival-scale artistic practice operating outside gallery/commercial circuits, e.g. CONTACT Photography). Drives display label and filtering."
    },
    "speaker_or_director": {
      "type": [
        "string",
        "null"
      ],
      "description": "Named speaker, author, artist, director, panel members, or host. Null when not yet confirmed."
    },
    "attendance_confirmed": {
      "type": "boolean",
      "description": "For screenings: director confirmed in attendance. For other types: named speaker confirmed (vs tentative). Default false until verified."
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Verification confidence 0-100. Threshold for auto-publish lives in /scripts/scrape_seminars.py config (default 70). Below threshold routes to review queue."
    },
    "four_condition_test": {
      "type": "object",
      "description": "Pass/fail per condition from the seminar-shape test. Filled by LLM verification pass.",
      "properties": {
        "time_place": {
          "type": "boolean"
        },
        "prepared_offering": {
          "type": "boolean"
        },
        "substantive_engagement": {
          "type": "boolean"
        },
        "intellectual_stake": {
          "type": "boolean"
        }
      }
    },
    "raw_excerpt": {
      "type": "string",
      "description": "Short verbatim excerpt from the source listing for verification trace. Max 500 chars."
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last fetched and verified."
    },
    "review_status": {
      "type": "string",
      "enum": [
        "auto-published",
        "queued",
        "rejected",
        "manual"
      ],
      "description": "Where this record lives. auto-published = live feed. queued = review queue at /data/seminars-review.json. rejected = excluded after manual review. manual = hand-curated by Saul, scraper does not overwrite."
    },
    "marginalia_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "After-attendance commentary link if a /marginalia/ piece exists for this event. Null until written."
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "If set, this record is a child event inside a parent festival record. Value is the parent's id. Display layer groups children under parent. Parent records leave this null."
    },
    "is_parent_festival": {
      "type": "boolean",
      "description": "True when this record represents the umbrella festival itself (with date range spanning the whole festival). False or omitted for one-off events including child events within a festival."
    },
