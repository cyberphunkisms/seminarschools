{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seminar event schema",
  "description": "Normalized record for events in the Seminar Schools calendar. Covers lectures, screenings, author readings, artist talks, panels, podcast recordings, religious-tradition scholar talks, and philosophy cafes that satisfy the four-condition test: known time and place, prepared offering by a designated participant, substantive engagement, real intellectual stake.",
  "type": "object",
  "required": [
    "id",
    "date",
    "title",
    "venue",
    "source_url",
    "type",
    "scraped_at",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier. SHA-1 hash of source_url plus ISO date, first 12 hex chars."
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time, ISO 8601 with timezone. Time may be approximate; date must be exact."
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Event end time. Null when source does not provide."
    },
    "title": {
      "type": "string",
      "description": "Event title as published by the source. No editorial rewriting."
    },
    "venue": {
      "type": "string",
      "description": "Physical or virtual venue. Format: Venue Name plus address or platform when available."
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL of the event listing or detail page."
    },
    "source_id": {
      "type": "string",
      "description": "Short identifier of the source roster entry that produced this record. Matches an id in /scripts/sources.json."
    },
    "type": {
      "type": "string",
